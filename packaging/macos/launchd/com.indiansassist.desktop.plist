<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Phase F section 17.3: the worker, started by launchd in every GUI login session (Aqua only; the login
     window is out of scope). It connects to the daemon's /var/run/indiansassist/worker.sock and captures and
     injects as the logged-in user, with that user's TCC grants. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.indiansassist.desktop</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/IndiansAssist/IndiansAssist Desktop.app/Contents/MacOS/ia-desktop</string>
	</array>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
