#!/bin/sh
# indiansassist-agent prerm (Phase F contract section 8.9).
# On removal (not on upgrade): the signed deregister (D section 4.1), bounded to 10 s, whose exit
# status is ignored: an offline host, an unreachable api or an unenrolled device never fails a
# removal or a purge (the server's heartbeat loss covers a device that could not say goodbye).
# Then the unit is disabled and stopped, only when systemd is running. Nothing is downloaded and no
# home directory is touched.
set -e

case "$1" in
  remove)
    if [ -x /usr/lib/indiansassist/ia-service ]; then
      if command -v timeout >/dev/null 2>&1; then
        timeout -k 2 10 /usr/lib/indiansassist/ia-service --deregister || true
      else
        /usr/lib/indiansassist/ia-service --deregister || true
      fi
    fi
    if [ -d /run/systemd/system ]; then
      systemctl disable --now indiansassist-agent >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
