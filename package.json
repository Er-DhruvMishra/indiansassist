{
  "name": "indiansassist",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "dev": "pnpm -r --parallel --filter ./apps/** dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:p2": "node scripts/smoke-p2.mjs",
    "smoke:recorder": "node scripts/smoke-recorder.mjs",
    "smoke:p3": "node scripts/smoke-p3.mjs",
    "smoke:p4": "node scripts/smoke-p4.mjs",
    "smoke:p4:load": "node scripts/smoke-p4-load.mjs",
    "smoke:e": "node scripts/smoke-e.mjs",
    "smoke:f": "node scripts/smoke-f.mjs",
    "secrets:reseal": "node scripts/reseal-org-secrets.mjs",
    "fleet:fixtures": "node scripts/gen-fleet-fixtures.mjs --check",
    "recorder:test": "cd services/recorder && go vet ./... && go test ./...",
    "recorder:build": "cd services/recorder && go build -o ../../data/recorder-bin/ ./cmd/recorder",
    "agent:build": "cargo build --manifest-path agent/Cargo.toml --workspace --all-features",
    "agent:test": "cargo test --manifest-path agent/Cargo.toml --workspace --all-features",
    "agent:clippy": "cargo clippy --manifest-path agent/Cargo.toml --all-targets --all-features -- -D warnings",
    "agent:release": "cargo build --manifest-path agent/Cargo.toml --release -p ia-agent",
    "agent:build:dev": "cargo build --manifest-path agent/Cargo.toml --release -p ia-agent --features dev",
    "agent:fixtures": "node scripts/gen-agent-fixtures.mjs --check",
    "validate:infra": "node scripts/validate-infra.mjs",
    "license:check": "node scripts/license-check.mjs",
    "agent:manifest": "node scripts/agent-manifest.mjs",
    "packaging:msi": "node packaging/windows/build.mjs",
    "packaging:msi:placeholder": "node packaging/windows/build.mjs --placeholder",
    "linux:pkg": "node packaging/linux/build.mjs",
    "agent:release:linux": "node packaging/linux/agent-release.mjs",
    "linux:throwaway": "powershell -NoProfile -ExecutionPolicy Bypass -File agent/scripts/throwaway-wsl.ps1",
    "packaging:test": "node --test packaging/windows/tools/enroll-config.test.mjs && cargo test --manifest-path packaging/windows/ca/Cargo.toml --locked",
    "test:scripts": "vitest run --config scripts/vitest.config.mjs",
    "e2e": "pnpm --filter @indiansassist/web e2e",
    "e2e:p3": "pnpm agent:build:dev && node apps/web/e2e/run-p3.mjs",
    "e2e:p3:linux": "node apps/web/e2e/run-p3-linux.mjs",
    "e2e:p3:mac": "node apps/web/e2e/run-p3-mac.mjs",
    "e2e:p4": "node apps/web/e2e/run-p4.mjs",
    "e2e:e": "pnpm --filter @indiansassist/web e2e enterprise- --pass-with-no-tests",
    "e2e:f": "node apps/web/e2e/run-f.mjs",
    "e2e:mobile": "pnpm --filter @indiansassist/web exec playwright test --config e2e/mobile.config.ts",
    "e2e:emulator": "pnpm --filter @indiansassist/web exec playwright test --config e2e/emulator.config.ts",
    "e2e:p4:linux": "node apps/web/e2e/run-p4-linux.mjs",
    "e2e:ext": "pnpm --filter @indiansassist/extension e2e",
    "android:build": "node apps/android/tools/gradle.mjs assembleDebug",
    "android:test": "node apps/android/tools/gradle.mjs testDebugUnitTest",
    "android:e2e": "node apps/android/tools/android-e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
