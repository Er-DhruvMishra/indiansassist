{
  "name": "indiansassist",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "dev": "pnpm -r --parallel --filter ./apps/** dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:p2": "node scripts/smoke-p2.mjs",
    "validate:infra": "node scripts/validate-infra.mjs",
    "test:scripts": "vitest run --config scripts/vitest.config.mjs",
    "e2e": "pnpm --filter @indiansassist/web e2e",
    "e2e:ext": "pnpm --filter @indiansassist/extension e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
