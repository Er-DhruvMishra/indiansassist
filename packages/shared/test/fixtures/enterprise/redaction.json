{
  "comment": "Phase E section 5.4 redaction vectors. Each positive must be redacted as `kind` (count >= 1) and its `secret` must not survive; `expected`, when present, is the exact output with a fresh RedactionState. Each negative must yield a zero count for `kind` (another kind may still fire).",
  "kinds": {
    "private_key": {
      "positives": [
        { "text": "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC\n-----END PRIVATE KEY-----", "secret": "MIIEvQIBADANBgkqhkiG9w0BAQEFAASC", "expected": "[private_key-1]" },
        { "text": "key:\n-----BEGIN RSA PRIVATE KEY-----\nabc123\n-----END RSA PRIVATE KEY-----\ndone", "secret": "abc123", "expected": "key:\n[private_key-1]\ndone" },
        { "text": "-----BEGIN OPENSSH PRIVATE KEY-----\nb3BlbnNzaC1rZXktdjEAAAAA", "secret": "b3BlbnNzaC1rZXktdjEAAAAA" }
      ],
      "negatives": ["-----BEGIN CERTIFICATE-----\nMIIB\n-----END CERTIFICATE-----", "-----BEGIN PUBLIC KEY-----"]
    },
    "jwt": {
      "positives": [
        { "text": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.abcdefghijklmnop", "secret": "eyJzdWIiOiIxMjM0NTY3ODkwIn0", "expected": "[jwt-1]" },
        { "text": "cookie=eyJ0eXAiOiJKV1QiLCJh.eyJleHAiOjE3MDAwMDAw.c2lnbmF0dXJlXzEyMw done", "secret": "eyJleHAiOjE3MDAwMDAw" },
        { "text": "id eyJraWQiOiIxMjM0NTY3OCJ9.eyJpc3MiOiJodHRwcyJ9.QUJDREVGR0hJSktM", "secret": "QUJDREVGR0hJSktM" }
      ],
      "negatives": ["eyJhbGc.short.x", "the eyes have it"]
    },
    "url_credential": {
      "positives": [
        { "text": "https://admin:s3cret@db.local/x", "secret": "s3cret", "expected": "https://[url_credential-1]@db.local/x" },
        { "text": "postgres://app:Pa55w0rd@10.0.0.5:5432/main", "secret": "Pa55w0rd" },
        { "text": "ftp://user:pw@files.example.test", "secret": "user:pw" }
      ],
      "negatives": ["https://example.test/path", "mailto user at host"]
    },
    "secret": {
      "positives": [
        { "text": "password: hunter2", "secret": "hunter2", "expected": "password: [secret-1]" },
        { "text": "Authorization: Bearer abc.def.ghi", "secret": "abc.def.ghi", "expected": "Authorization: Bearer [secret-1]" },
        { "text": "API_KEY=xyz987", "secret": "xyz987" },
        { "text": "id AKIAIOSFODNN7EXAMPLE", "secret": "AKIAIOSFODNN7EXAMPLE", "expected": "id [secret-1]" },
        { "text": "ghp_abcdefghijklmnopqrstuvwxyz0123456789AB", "secret": "ghp_abcdefghijklmnopqrstuvwxyz0123456789AB" },
        { "text": "slack xoxb-1234567890-abcdef", "secret": "xoxb-1234567890-abcdef" },
        { "text": "use sk-proj-abcdefghijklmnopqrstuv", "secret": "sk-proj-abcdefghijklmnopqrstuv" },
        { "text": "    Key Content            : My Wifi Pass 1", "secret": "My Wifi Pass 1", "expected": "    Key Content            : [secret-1]" },
        { "text": "psk=\"secret phrase\"", "secret": "secret phrase", "expected": "psk=[secret-1]" },
        { "text": "wpa_passphrase=CorrectHorse9", "secret": "CorrectHorse9" }
