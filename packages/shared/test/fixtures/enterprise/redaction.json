    "user_path": {
      "positives": [
        { "text": "C:\\Users\\priya\\AppData\\Local", "secret": "priya", "expected": "C:\\Users\\[user_path-1]\\AppData\\Local" },
        { "text": "/home/ravi/.ssh/config", "secret": "ravi", "expected": "/home/[user_path-1]/.ssh/config" },
        { "text": "open /Users/anita/Desktop/x.txt", "secret": "anita" },
        { "text": "d:/users/Mohan.K/Documents", "secret": "Mohan.K" }
      ],
      "negatives": ["C:\\Program Files\\App", "/usr/local/bin"]
    },
    "long_token": {
      "positives": [
        { "text": "hash 0123456789abcdef0123456789abcdef0123456789abcdef", "secret": "0123456789abcdef0123456789abcdef0123456789abcdef", "expected": "hash [long_token-1]" },
        { "text": "cookie sessionid=QWxhZGRpbjpvcGVuIHNlc2FtZQAAAAAAAAAAAAAAAAAAAAAA", "secret": "QWxhZGRpbjpvcGVuIHNlc2FtZQAAAAAAAAAAAAAAAAAAAAAA" },
        { "text": "x AAAAB3NzaC1yc2EAAAADAQABAAABAQC7vbqajDhAAAA", "secret": "AAAAB3NzaC1yc2EAAAADAQABAAABAQC7vbqajDhAAAA" }
      ],
      "negatives": ["short-token-123", "a sentence with many ordinary words in it"]
    }
  },
  "numbering": [
    {
      "comment": "one state across several texts: the same value keeps its number, case-insensitive for emails",
      "texts": ["mail priya@example.com", "again PRIYA@example.com and bob@x.org", "call +919876543210 or +91 98765 43210"],
      "expected": ["mail [email-1]", "again [email-1] and [email-2]", "call [phone-1] or [phone-1]"]
    },
    {
      "comment": "placeholders already present are opaque and new numbers start above them",
      "texts": ["[email-3] new a@b.co and [phone-1]"],
      "expected": ["[email-3] new [email-4] and [phone-1]"]
    }
  ]
}
