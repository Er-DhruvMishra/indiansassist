{
  "comment": "Phase E section 5.7b-e / 15.4: canned Messages API responses and what interpretAnthropicResponse(message, requestedGeo) must return. `output` is compared deeply when ok; `detailContains` is a substring of the failure detail.",
  "requestedGeo": "global",
  "cases": [
    {
      "name": "end_turn with a valid JSON answer",
      "message": {
        "id": "msg_01",
        "type": "message",
        "role": "assistant",
        "model": "claude-opus-5-5",
        "stop_reason": "end_turn",
        "stop_details": null,
        "stop_sequence": null,
        "content": [
          { "type": "thinking", "thinking": "", "signature": "sig" },
          { "type": "text", "text": "{\"summary\":\"The technician cleared the print queue.\",\"outcome\":\"resolved\",\"actionsTaken\":[\"Restarted the spooler\"],\"issuesFound\":[\"Stuck job\"],\"followUps\":[],\"ticketNote\":\"Cleared the queue.\"}" }
        ],
        "usage": { "input_tokens": 1200, "output_tokens": 300, "inference_geo": "us", "iterations": null }
      },
      "expect": {
        "ok": true,
        "servedModel": "claude-opus-5-5",
        "inferenceGeo": "us",
        "fallbackUsed": false,
        "usage": { "inputTokens": 1200, "outputTokens": 300 },
        "output": { "summary": "The technician cleared the print queue.", "outcome": "resolved", "actionsTaken": ["Restarted the spooler"], "issuesFound": ["Stuck job"], "followUps": [], "ticketNote": "Cleared the queue." }
      }
    },
    {
      "name": "end_turn with non-JSON text",
      "message": {
        "model": "claude-opus-5-5",
        "stop_reason": "end_turn",
        "stop_details": null,
        "content": [{ "type": "text", "text": "Here is the summary: the queue was cleared." }],
        "usage": { "input_tokens": 10, "output_tokens": 5 }
      },
      "expect": { "ok": false, "cause": "invalid_output", "detailContains": "not JSON" }
    },
    {
      "name": "refusal with a category",
      "message": {
        "model": "claude-opus-5-5",
        "stop_reason": "refusal",
        "stop_details": { "type": "refusal", "category": "cyber", "explanation": "declined" },
        "content": [],
        "usage": { "input_tokens": 10, "output_tokens": 0 }
      },
      "expect": { "ok": false, "cause": "refused", "detailContains": "cyber" }
    },
    {
      "name": "max_tokens",
      "message": {
        "model": "claude-opus-5-5",
        "stop_reason": "max_tokens",
        "stop_details": null,
        "content": [{ "type": "text", "text": "{\"summary\":\"The tech" }],
        "usage": { "input_tokens": 10, "output_tokens": 16000 }
      },
      "expect": { "ok": false, "cause": "truncated" }
    },
    {
      "name": "fallback served: the answer is the text block after the fallback block, the decoy before it is ignored",
      "message": {
        "model": "claude-opus-5",
        "stop_reason": "end_turn",
        "stop_details": null,
        "content": [
          { "type": "text", "text": "{\"summary\":\"DECOY\",\"outcome\":\"unknown\",\"actionsTaken\":[],\"issuesFound\":[],\"followUps\":[],\"ticketNote\":\"DECOY\"}" },
          { "type": "fallback", "from": { "model": "claude-opus-5-5" }, "to": { "model": "claude-opus-5" }, "trigger": { "type": "refusal" } },
          { "type": "text", "text": "{\"summary\":\"Served by the fallback.\",\"outcome\":\"partially_resolved\",\"actionsTaken\":[],\"issuesFound\":[],\"followUps\":[\"Call back\"],\"ticketNote\":\"Fallback note.\"}" }
        ],
        "usage": {
          "input_tokens": 50,
          "output_tokens": 20,
          "iterations": [
            { "type": "message", "input_tokens": 25, "output_tokens": 0 },
            { "type": "fallback_message", "model": "claude-opus-5", "input_tokens": 25, "output_tokens": 20 }
          ]
        }
      },
      "expect": {
        "ok": true,
        "servedModel": "claude-opus-5",
        "inferenceGeo": "global",
        "fallbackUsed": true,
        "usage": { "inputTokens": 50, "outputTokens": 20 },
        "output": { "summary": "Served by the fallback.", "outcome": "partially_resolved", "actionsTaken": [], "issuesFound": [], "followUps": ["Call back"], "ticketNote": "Fallback note." }
      }
    },
    {
      "name": "a sticky fallback turn signalled only by usage.iterations",
      "message": {
        "model": "claude-opus-5",
        "stop_reason": "end_turn",
        "content": [{ "type": "text", "text": "{\"summary\":\"S\",\"outcome\":\"unknown\",\"actionsTaken\":[],\"issuesFound\":[],\"followUps\":[],\"ticketNote\":\"N\"}" }],
        "usage": { "input_tokens": 5, "output_tokens": 5, "iterations": [{ "type": "fallback_message", "model": "claude-opus-5", "input_tokens": 5, "output_tokens": 5 }] }
      },
      "expect": { "ok": true, "servedModel": "claude-opus-5", "inferenceGeo": "global", "fallbackUsed": true, "usage": { "inputTokens": 5, "outputTokens": 5 }, "output": { "summary": "S", "outcome": "unknown", "actionsTaken": [], "issuesFound": [], "followUps": [], "ticketNote": "N" } }
    },
    {
      "name": "any other stop_reason",
      "message": { "model": "claude-opus-5-5", "stop_reason": "pause_turn", "content": [], "usage": { "input_tokens": 1, "output_tokens": 1 } },
      "expect": { "ok": false, "cause": "invalid_output", "detailContains": "pause_turn" }
    }
  ]
}
