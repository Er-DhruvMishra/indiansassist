{
  "about": "Phase F section 7.2 gesture fixtures: touch samples [t ms, kind, pointerId, x px, y px] on a 1000 x 1000 px view, replayed through createGestureRecognizer (DEFAULT_GESTURE_CONFIG merged with `config`), ticked at `end`, each gesture point divided by the view size, then mapped by mapGestureToOps(gesture, desk, mode). `expect` is the flat list of outputs (numbers compared to 6 decimals). Replayed by packages/shared/test/touch-gestures.test.ts.",
  "view": { "w": 1000, "h": 1000 },
  "cases": [
    {
      "name": "tap: native Desk with control clicks button 0 after the double-tap window",
      "desk": { "kind": "native", "control": true },
      "mode": { "zoom": 1, "trackpad": false, "scrollWhileZoomed": false },
      "samples": [[0, "down", 1, 500, 500], [100, "up", 1, 502, 501]],
      "end": 500,
      "expect": [{ "kind": "op", "op": "os.pointer", "args": { "kind": "click", "nx": 0.5, "ny": 0.5, "button": 0 } }]
    },
    {
      "name": "tap: Android Desk with control clicks like a native Desk",
