# apps/extension build configuration (docs/specs/phase-b-contracts.md section 9.1). Copy to .env (or set in the
# environment; the environment wins).

# Exact region origins of the web app, `region=origin`, comma separated (the same variable the web app uses).
# Production: https only, no wildcard, no path. Leave empty for a dev build (adds http://localhost:5173 and
# http://127.0.0.1:5173 automatically).
VITE_REGION_ORIGINS=

# 1 = dev build (local origins, local connect-src), 0 = production build. Unset: dev when VITE_REGION_ORIGINS is empty.
IA_DEV=

# Dev builds only: where REST calls go when the web origin is not the api origin (Vite :5173 vs api :4000).
VITE_API_URL=http://localhost:4000

# Default API origin for side panel / popup code entry (must be one of the region origins).
VITE_DEFAULT_API_ORIGIN=

# Optional: the manifest "key" (base64 public key) that pins the unpacked extension id, so the api can list it
# in EXTENSION_IDS.
EXTENSION_KEY=

# 1 = e2e build for the Playwright suite (section 13.2).
IA_E2E=
