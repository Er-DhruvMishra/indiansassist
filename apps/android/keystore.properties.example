# Copy to apps/android/keystore.properties (git-ignored) to sign release builds locally (docs/release.md section 4.5).
# The keystore stays outside the repository; nothing here is a secret until you fill it in, and the filled-in copy
# must never be committed. The environment variables IA_ANDROID_KEYSTORE, IA_ANDROID_KEYSTORE_PASSWORD,
# IA_ANDROID_KEY_ALIAS and IA_ANDROID_KEY_PASSWORD do the same (CI uses them).
storeFile=C:/Users/<you>/.indiansassist/signing/indiansassist-android-release.p12
storePassword=<the contents of android-keystore-password.txt>
keyAlias=indiansassist
keyPassword=<the same password: a PKCS#12 store has one>
