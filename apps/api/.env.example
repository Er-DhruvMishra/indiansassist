# @indiansassist/api environment (contracts docs/specs/phase-a-contracts.md section 11.1).
# The api reads `.env` from the REPO ROOT (dotenv); copy the lines you need there. Every variable has a dev default,
# so the api starts with none of them set. NODE_ENV=production makes the "prod: required" values mandatory.

NODE_ENV=development
PORT=4000
# Prometheus listener (/metrics); 0 disables it. Never proxy it through nginx.
METRICS_PORT=9464
HOST=0.0.0.0
# Session owner id (section 7.6); default <hostname>:<pid>.
NODE_ID=
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Empty => embedded PGlite at PGLITE_DIR; otherwise postgres://user:pass@host:5432/db (prod: the DB_APP_ROLE role).
DATABASE_URL=
# Owner-role connection used only for migrations (defaults to DATABASE_URL).
MIGRATE_DATABASE_URL=
PGLITE_DIR=./data/pglite
# prod: required. Migrations revoke UPDATE / DELETE / TRUNCATE on audit_entry and audit_checkpoint from it.
DB_APP_ROLE=

# prod: required (>= 32 chars). Dev: generated once and persisted to ./data/cookie.secret.
SESSION_COOKIE_SECRET=
# prod: required. 32-byte Ed25519 seed as 64 hex chars. Dev: generated once and persisted to ./data/signing.key.
TOKEN_SIGNING_KEY=
# Comma list of retired PUBLIC keys (base64url, 43 chars), still listed in /.well-known for verification.
TOKEN_SIGNING_KEYS_PREVIOUS=

DEFAULT_REGION=in-mum
# Empty = all regions (single-node dev). Production: exactly one region per cluster.
SERVED_REGIONS=
REGION_ORIGINS=in-mum=http://localhost:5173,eu-fra=http://localhost:5173,us-east=http://localhost:5173

# coturn static-auth-secret; prod: required (>= 32 chars) whenever TURN_URLS is set.
TURN_SECRET=dev-turn-secret
# e.g. turn:turn.in-mum.indianscloud.com:3478?transport=udp,turns:turn.in-mum.indianscloud.com:5349
TURN_URLS=
# Empty = host candidates only (fine on a LAN). No third-party STUN by default (PRD principle 2).
STUN_URLS=
# STUN=stun:stun.l.google.com:19302   (third-party; listed in the residency report if you enable it)
# Host suffixes considered first-party for the residency report; default: host of API_ORIGIN.
ICE_OWN_HOST_SUFFIXES=
TURN_TTL_SECONDS=3600

# memory (single node: run ONE api replica, infra/HARDENING.md section 10) | redis (not shipped in this build)
PRESENCE_DRIVER=memory
REDIS_URL=

# fs | s3
STORAGE_DRIVER=fs
STORAGE_FS_DIR=./data/storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# local | oidc (oidc is a Phase E stub)
AUTH_PROVIDER=local
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Recording storage quotas (review SEC-08): bytes per org including open uploads (0 = unlimited), concurrent
# open uploads per org and per user, and how long after a session ended its recording may still be uploaded.
ORG_STORAGE_QUOTA_BYTES=53687091200
ORG_MAX_OPEN_UPLOADS=10
USER_MAX_OPEN_UPLOADS=3
RECORDING_UPLOAD_WINDOW_SEC=86400

LOG_LEVEL=info
# Tests only: disables every HTTP, WS and per-key limit.
RATE_LIMIT_DISABLED=false

# ---------- Phase B (docs/specs/phase-b-contracts.md sections 2, 4.6, 11.3, Y21) ----------
# Comma list of Chrome extension ids (32 chars a-p). Also the Y21 Origin allow-list for POST /tokens/public-lookup
# and the /signal upgrade. Empty: any chrome-extension:// origin outside production (unpacked dev builds).
EXTENSION_IDS=
# Store listing URLs for the join page (empty => null: the page shows the developer install).
EXTENSION_WEBSTORE_URL=
EXTENSION_EDGE_URL=
EXTENSION_MIN_VERSION=0.2.0
# Per-session WS mirror relay budget: base64url characters per sliding 10 s (about 400 kbps).
MIRROR_RELAY_BUDGET_BYTES=524288
# org.plan_tier of orgs created by signup (billing is out of scope; seats still start at p1_browser).
SIGNUP_PLAN_TIER=p2_extension

# ---------- Phase A.2 (docs/specs/phase-a2-recorder.md section 13) ----------
# Service token of the server-side recorder (services/recorder uses the same value). Empty = recorder disabled
# (recorder.hello, POST /api/v1/internal/recordings and the bearer ICE route are refused). prod: >= 32 chars.
RECORDER_TOKEN=

# ---------- Phase C (docs/specs/phase-c-contracts.md sections 2.2, 2.6, 13.3) ----------
# Directory with manifest.json and the agent builds it names (IndiansAssist-windows-x64-<version>.exe, ...);
# git-ignored. Without it the manifest is empty and POST /download/prepare answers 503 download_unavailable.
AGENT_DIST_DIR=./data/agent-dist
# desk.hello from an agent below this version is refused with join_unsupported { minVersion }.
AGENT_MIN_VERSION=0.3.0
# Store link of the Android host app for the join page (empty => null: the page offers the APK when one is served).
AGENT_ANDROID_APP_URL=
# Dev only (ignored when NODE_ENV=production): when AGENT_DIST_DIR has no manifest.json, this placeholder file
# (created on first start) is served as the Windows x64 / arm64 build so the join page and smoke:p3 work locally.
# Empty disables it.
AGENT_DEV_STUB=./data/agent-dev-stub.bin
