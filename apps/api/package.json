{
  "name": "@indiansassist/api",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "IndiansAssist REST API and WebSocket signaling server (Fastify 5 + ws), contracts docs/specs/phase-a-contracts.md sections 6, 7, 9, 10, 11.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-s3": "3.1153.0",
    "@aws-sdk/s3-request-presigner": "3.1153.0",
    "@electric-sql/pglite": "0.5.11",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@indiansassist/db": "workspace:*",
    "@indiansassist/shared": "workspace:*",
    "@node-saml/node-saml": "5.2.0",
    "@peculiar/x509": "3.1.0",
    "argon2": "^0.45.1",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.7",
    "ioredis": "5.11.1",
    "nodemailer": "^10.1.4",
    "openid-client": "6.8.8",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "undici": "8.12.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "jose": "6.2.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "xml-crypto": "6.4.0"
  }
}
