# IndiansAssist self-host environment, ONE region cluster (contracts section 11).
# Copy to infra/.env (git-ignored) or run `sh infra/scripts/init-env.sh` to generate every secret.
# Compose reads this file for interpolation; the api receives the values listed in docker-compose.yml.
# Empty secrets make `docker compose up` refuse to start: there are no default passwords.
# Generate values with:  openssl rand -hex 32   (64 hex chars)

# ======================================================================================================
# Region and origins (sections 1, 11.1)
# ======================================================================================================
# This stack's region: in-mum | eu-fra | us-east. The api serves exactly this region (SERVED_REGIONS).
DEFAULT_REGION=in-mum
# Comma list of regions this node serves. Compose sets it to DEFAULT_REGION; documented here for completeness.
SERVED_REGIONS=in-mum
# Public https origin of this region cluster. Production: API_ORIGIN === WEB_ORIGIN (nginx proxies the api).
WEB_ORIGIN=https://in.indiansassist.example
API_ORIGIN=https://in.indiansassist.example
# region=webOrigin list used in 421 region_mismatch answers (section 1.2 R3). List every region you run.
REGION_ORIGINS=in-mum=https://in.indiansassist.example,eu-fra=https://eu.indiansassist.example,us-east=https://us.indiansassist.example

# ======================================================================================================
# api process (section 11.1)
# ======================================================================================================
NODE_ENV=production
PORT=4000
# Prometheus listener, internal only (never proxied by nginx). 0 disables it.
METRICS_PORT=9464
HOST=0.0.0.0
# Leave empty: Compose does not pass it and the api defaults to <hostname>:<pid> (section 7.6).
NODE_ID=
# Compose sets TRUST_PROXY=true (nginx overwrites X-Forwarded-For with the client address).
TRUST_PROXY=true
LOG_LEVEL=info
# Never true in production (tests only).
RATE_LIMIT_DISABLED=false

# ======================================================================================================
# Postgres (sections 4.2, 11.3): ia_owner runs migrations, ia_app is the api's role (append-only audit)
# ======================================================================================================
POSTGRES_DB=indiansassist
POSTGRES_OWNER_USER=ia_owner
POSTGRES_OWNER_PASSWORD=
DB_APP_ROLE=ia_app
IA_APP_DB_PASSWORD=
# Compose builds both URLs from the values above; set them by hand only outside Compose.
# DATABASE_URL=postgres://ia_app:<IA_APP_DB_PASSWORD>@postgres:5432/indiansassist
# MIGRATE_DATABASE_URL=postgres://ia_owner:<POSTGRES_OWNER_PASSWORD>@postgres:5432/indiansassist
DATABASE_URL=
MIGRATE_DATABASE_URL=
# Dev-only PGlite directory (unused when DATABASE_URL is set).
PGLITE_DIR=./data/pglite

# ======================================================================================================
# Secrets (sections 3, 6.1). prod: required
# ======================================================================================================
# >= 32 chars; cookie signing and HKDF input of the presign key.
SESSION_COOKIE_SECRET=
# Ed25519 seed, exactly 64 hex chars (tokens and audit checkpoints).
TOKEN_SIGNING_KEY=
# Comma list of RETIRED public keys (base64url, 43 chars) kept in /.well-known until their tokens expire.
TOKEN_SIGNING_KEYS_PREVIOUS=

# ======================================================================================================
# TURN / STUN (sections 6.11, 11.5). TURN_SECRET must be identical in the api and coturn.
# ======================================================================================================
# >= 32 chars; coturn static-auth-secret.
TURN_SECRET=
TURN_REALM=turn.in.indiansassist.example
# Public IPv4 of the Docker host (or "public/private" behind 1:1 NAT).
TURN_EXTERNAL_IP=203.0.113.10
# Relay range: dev 49160-49200 (published by Compose); production 49152-65535 with docker-compose.turn-host.yml.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_URLS=turn:turn.in.indiansassist.example:3478?transport=udp,turn:turn.in.indiansassist.example:3478?transport=tcp,turns:turn.in.indiansassist.example:5349
STUN_URLS=stun:turn.in.indiansassist.example:3478
# Third-party STUN is opt-in only (PRD principle 2). Example, NOT enabled:
# STUN_URLS=stun:turn.in.indiansassist.example:3478,stun:stun.l.google.com:19302
# Host suffixes treated as first-party in the residency report (ResidencyReport.ice.thirdPartyHosts).
ICE_OWN_HOST_SUFFIXES=indiansassist.example
TURN_TTL_SECONDS=3600

# ======================================================================================================
# Presence (section 10.2). Compose always uses redis (Valkey).
# ======================================================================================================
PRESENCE_DRIVER=redis
VALKEY_PASSWORD=
# Compose builds it as redis://:<VALKEY_PASSWORD>@valkey:6379/0
REDIS_URL=

# ======================================================================================================
# Object storage (sections 9, 10.1). One bucket per region cluster.
# ======================================================================================================
STORAGE_DRIVER=s3
STORAGE_FS_DIR=./data/storage
# Default: SeaweedFS service in this stack. For Garage (profile `garage`): http://garage:3900 and S3_REGION=garage.
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=ia-recordings-in-mum
# Alphanumeric. For Garage compatibility use GK + 24 hex chars (key id) and 64 hex chars (secret).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# Garage profile only (64 hex chars each).
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Recording uploads (section 6.10): per-org bytes (stored + open uploads; 0 = unlimited), open uploads per org and
# per uploader, and how long after a session ended an upload is still accepted.
ORG_STORAGE_QUOTA_BYTES=53687091200
ORG_MAX_OPEN_UPLOADS=10
USER_MAX_OPEN_UPLOADS=3
RECORDING_UPLOAD_WINDOW_SEC=86400
# fs driver only: origin of signed recording download URLs. Empty = API_ORIGIN. Point a separate hostname that never
# serves the web app (and so never holds the session cookie) at /api/v1/recordings/*/file to isolate downloads.
RECORDING_DOWNLOAD_ORIGIN=

# ======================================================================================================
# Package 2: browser extension (docs/specs/phase-b-contracts.md sections 2, 4.6, 11.3, Y21)
# ======================================================================================================
# Comma list of Chrome / Edge extension ids (32 chars a-p) allowed to call public-lookup and open /signal
# (Origin chrome-extension://<id>). Production: REQUIRED for P2, list your store and unpacked ids. Empty outside
# production accepts any extension origin (dev only).
EXTENSION_IDS=
# Store listing URLs shown on the join page (empty: the page shows the developer install steps).
EXTENSION_WEBSTORE_URL=
EXTENSION_EDGE_URL=
# Oldest extension version the join page accepts.
EXTENSION_MIN_VERSION=0.2.0
# Per-session WS mirror relay budget: base64url characters per sliding 10 s (about 400 kbps). The relay is a
# declared plaintext gap (Y22); an org can refuse it with policy.allowRelayFallback.
MIRROR_RELAY_BUDGET_BYTES=524288
# org.plan_tier given to orgs created by signup (seats still start at p1_browser).
SIGNUP_PLAN_TIER=p2_extension

# ======================================================================================================
# Auth (section 10.3). OIDC / Keycloak is Phase E.
# ======================================================================================================
AUTH_PROVIDER=local
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Keycloak (Compose profile `sso`): both required before `--profile sso up`.
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=ia-admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_HOSTNAME=

# ======================================================================================================
# Web build (section 11.2): compiled into the bundle by apps/web/Dockerfile
# ======================================================================================================
# VITE_API_URL is set to WEB_ORIGIN by Compose (same origin through nginx).
VITE_API_URL=https://in.indiansassist.example
# Allow-list for following 421 redirects and the /login region picker; https: only in production.
VITE_REGION_ORIGINS=in-mum=https://in.indiansassist.example,eu-fra=https://eu.indiansassist.example,us-east=https://us.indiansassist.example
VITE_APP_NAME=IndiansAssist

# ======================================================================================================
# Misc
# ======================================================================================================
# Image tag for indiansassist/api and indiansassist/web.
IA_VERSION=local
# CN of the development self-signed certificate generated when infra/certs is empty.
IA_TLS_SELF_SIGNED_CN=localhost

# ---------- Phase A.2 server-side recorder (docs/specs/phase-a2-recorder.md section 13) ----------
# Service token shared by the api and the recorder (>= 32 chars in production; empty = recorder disabled).
# Generate: openssl rand -base64 36. Start the recorder with: docker compose --profile recorder up -d
RECORDER_TOKEN=
RECORDER_ID=recorder-1
RECORDER_MAX_SESSIONS=8
RECORDER_MAX_DURATION=4h
RECORDER_UPLOAD_RETRIES=5
RECORDER_KEEP_FILES=false
# UDP range published for the recorder's ICE host candidates, and the public IP advertised for them (NAT).
RECORDER_UDP_PORT_MIN=50000
RECORDER_UDP_PORT_MAX=50100
RECORDER_PUBLIC_IP=

# ---------- Phase C portable client (docs/specs/phase-c-contracts.md sections 2.2, 2.6, 13.3) ----------
# Directory (inside the api container) with manifest.json and the signed agent builds CI publishes
# (IndiansAssist-windows-x64-<version>.exe, IndiansAssist-windows-arm64-<version>.exe,
# IndiansAssist-android-universal-<version>.apk). Without it /download/prepare answers 503 and the join page says the
# support client is not available on this server.
AGENT_DIST_DIR=/data/agent-dist
# desk.hello from an agent below this version is refused with join_unsupported { minVersion }.
AGENT_MIN_VERSION=0.3.0
# Play Store link of the Android host app (empty => null: the join page offers the APK when one is served).
AGENT_ANDROID_APP_URL=
# Dev placeholder build; ignored in production (NODE_ENV=production). Keep empty here.
AGENT_DEV_STUB=
